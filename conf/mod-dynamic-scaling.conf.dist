[worldserver]

########################################
# mod-dynamic-scaling configuration
########################################
#
# Where settings come from, most specific first:
#   1. `dynamic_scaling_zone` row for the area     (e.g. Northshire Valley)
#   2. `dynamic_scaling_zone` row for the zone     (e.g. Elwynn Forest)
#   3. `dynamic_scaling_map`  row for the map      (an instance + difficulty, or a whole continent)
#   4. The defaults in this file
#
# Level windows (level_min / level_max in both tables):
#   N  = creatures never go below / above level N
#   0  = creatures never go below / above their own level
#   0/0 = creatures keep their own level (cities, starting areas)

#
#    DynamicScaling.Enable
#        Description: Turn the whole module on or off.
#        Default:     1 - enabled
#                     0 - disabled

DynamicScaling.Enable = 1

#
#    DynamicScaling.Announce
#        Description: Tell players on login that the module runs, and tell them their Simple mode buff
#                     when they enter an instance.
#        Default:     1 - enabled
#                     0 - disabled

DynamicScaling.Announce = 1

#
#    DynamicScaling.PlayerToggle.Enable
#        Description: Let players pick their own open world scaling with .scaling simple / advanced / off:
#                       Simple   - creatures trail behind your level anywhere in the open world (Ascension style):
#                                  World.Simple.TrailLevels below you, whatever the zone's level range.
#                       Advanced - creatures trail behind you inside each zone's level window, with the per row
#                                  trail, health, damage and XP floor of `dynamic_scaling_zone`.
#                       Off      - creatures keep their own levels. No Simple mode buff in instances, no XP floors,
#                                  left out of an instance's reference level, and see World.Off.NoQuestCreditLevels.
#                     A creature scales for the nearest player (World.Reference), with that player's choice.
#        Default:     1 - enabled
#                     0 - disabled (everyone uses PlayerToggle.Default; Off counts as Simple)

DynamicScaling.PlayerToggle.Enable = 1

#
#    DynamicScaling.PlayerToggle.Default
#        Description: Choice for players who never used .scaling.
#        Default:     1 - Simple
#                     2 - Advanced
#                     0 - Off (players opt in)

DynamicScaling.PlayerToggle.Default = 1

#
#    DynamicScaling.Collective.WorldRandomizer
#        Description: Work together with mod-world-randomizer. Only takes effect when that module is installed and
#                     enabled (Randomizer.Enable and Randomizer.World.Enable) and its own switch
#                     Randomizer.Collective.DynamicScaling is on too. Then:
#                       - dungeons and raids use Simple mode, with creature levels scaled to the group inside the
#                         bracket their entrance zone landed in (RFC in a 31-40 bracket scales between 31 and 40),
#                       - open world scaling is off, because the randomizer sets zone levels itself.
#                     Dungeons whose entrance is not in a shuffled zone keep the normal settings.
#        Default:     1 - enabled
#                     0 - disabled (the two modules ignore each other)

DynamicScaling.Collective.WorldRandomizer = 1

########################################
# Instances (dungeons and raids)
########################################
#
#    DynamicScaling.Instance.Enable
#        Description: Scale instances.
#        Default:     1 - enabled
#                     0 - disabled

DynamicScaling.Instance.Enable = 1

#
#    DynamicScaling.Instance.DefaultMode
#        Description: Mode for instances with no `dynamic_scaling_map` row (or a row with mode 255).
#        Default:     1 - Simple   (SoloCraft style: players get stats / spell power for every missing player)
#                     2 - Advanced (AutoBalance style: creatures get less health / damage for fewer players)
#                     0 - Off      (level scaling and respawn can still apply)

DynamicScaling.Instance.DefaultMode = 1

#
#    DynamicScaling.Instance.IncludeRaids
#    DynamicScaling.Instance.IncludeHeroics
#        Description: Scale raids / heroic difficulties at all.
#        Default:     1 - enabled

DynamicScaling.Instance.IncludeRaids = 1
DynamicScaling.Instance.IncludeHeroics = 1

#
#    DynamicScaling.Instance.LevelScaling.Enable
#        Description: Move instance creature levels to the group's level (inside the level window).
#                     Every creature moves by the same amount, so bosses stay above their trash.
#        Default:     1 - enabled
#                     0 - disabled

DynamicScaling.Instance.LevelScaling.Enable = 1

#
#    DynamicScaling.Instance.LevelScaling.Reference
#        Description: Which player level the instance scales to.
#        Default:     0 - highest player
#                     1 - average
#                     2 - lowest player

DynamicScaling.Instance.LevelScaling.Reference = 0

#
#    DynamicScaling.Instance.LevelScaling.DefaultLevelMin
#    DynamicScaling.Instance.LevelScaling.DefaultLevelMax
#        Description: Level window for instances with no row. 0 = the creature's own level.
#                     1 / 80 lets every instance scale fully both ways.
#        Default:     1 / 80

DynamicScaling.Instance.LevelScaling.DefaultLevelMin = 1
DynamicScaling.Instance.LevelScaling.DefaultLevelMax = 80

#
#    DynamicScaling.Instance.Simple.SpellId
#        Description: Server side aura that carries the Simple mode stat buff (see the SQL file).
#        Default:     150100

DynamicScaling.Instance.Simple.SpellId = 150100

#
#    DynamicScaling.Instance.Simple.StatsMult
#        Description: Stat bonus, in percent, for each missing player. Solo in a 5 player dungeon at 100
#                     gives +400% stats (as strong as 5 players).
#        Default:     100

DynamicScaling.Instance.Simple.StatsMult = 100

#
#    DynamicScaling.Instance.Simple.SpellPowerMult
#        Description: Extra spell power for casters, as a multiple of their gear spell power, per missing player.
#        Default:     1.0

DynamicScaling.Instance.Simple.SpellPowerMult = 1.0

#
#    DynamicScaling.Instance.Simple.XPPenalty
#        Description: Scale instance XP by group size / expected players while buffed.
#        Default:     0 - disabled
#                     1 - enabled

DynamicScaling.Instance.Simple.XPPenalty = 0

#
#    DynamicScaling.Instance.Advanced.HealthFloor
#    DynamicScaling.Instance.Advanced.DamageFloor
#    DynamicScaling.Instance.Advanced.ManaFloor
#        Description: Creature health / damage / mana with a single player, as a fraction of normal.
#                     It rises in a straight line to 1.0 at the expected player count.
#        Default:     0.3 / 0.3 / 0.5

DynamicScaling.Instance.Advanced.HealthFloor = 0.3
DynamicScaling.Instance.Advanced.DamageFloor = 0.3
DynamicScaling.Instance.Advanced.ManaFloor = 0.5

#
#    DynamicScaling.Instance.Advanced.HealthMult
#    DynamicScaling.Instance.Advanced.DamageMult
#        Description: Global multipliers on top of everything else in Advanced mode.
#        Default:     1.0

DynamicScaling.Instance.Advanced.HealthMult = 1.0
DynamicScaling.Instance.Advanced.DamageMult = 1.0

#
#    DynamicScaling.Instance.Respawn.Enable
#        Description: Releasing your spirit inside an instance brings you back alive at the instance entrance
#                     (or the map row's respawn_x/y/z/o), instead of the graveyard outside.
#        Default:     1 - enabled
#                     0 - disabled

DynamicScaling.Instance.Respawn.Enable = 1

#
#    DynamicScaling.Instance.Respawn.Raids
#        Description: Also respawn inside raids.
#        Default:     1 - enabled

DynamicScaling.Instance.Respawn.Raids = 1

#
#    DynamicScaling.Instance.Respawn.HealthPct
#        Description: Health and mana percent after the respawn.
#        Default:     50

DynamicScaling.Instance.Respawn.HealthPct = 50

########################################
# Open world
########################################
#
#    DynamicScaling.World.Enable
#        Description: Scale open world creatures to trail behind the player's level.
#        Default:     1 - enabled
#                     0 - disabled

DynamicScaling.World.Enable = 1

#
#    DynamicScaling.World.DefaultMode
#        Description: Whether places with no zone, area or map row scale. The shipped zone rows cover every
#                     outdoor zone, so this only matters for places without a row. A row with mode 0, or with
#                     level_min = level_max = 0 (cities, starting areas), never scales; any other row scales the
#                     way each player chose (Simple or Advanced).
#        Default:     0 - not scaled
#                     1 - scaled

DynamicScaling.World.DefaultMode = 0

#
#    DynamicScaling.World.Simple.TrailLevels
#        Description: Simple: how many levels creatures sit below the player. With LevelSpread 1, a level 60 sees
#                     level 57-58 creatures and a level 12 sees 9-10, in any zone.
#        Default:     3

DynamicScaling.World.Simple.TrailLevels = 3

#
#    DynamicScaling.World.TrailLevels
#        Description: Advanced: how many levels creatures sit below the player, inside the zone's level window
#                     (a row's trail_levels overrides it).
#        Default:     2

DynamicScaling.World.TrailLevels = 2

#
#    DynamicScaling.World.LevelSpread
#        Description: Keep up to this many levels of the creature's own template range, so a pack is not
#                     all one level.
#        Default:     1

DynamicScaling.World.LevelSpread = 1

#
#    DynamicScaling.World.Reference
#        Description: Which nearby player a creature scales to.
#        Default:     3 - nearest
#                     0 - highest level
#                     2 - lowest level

DynamicScaling.World.Reference = 3

#
#    DynamicScaling.World.GroupAverage
#        Description: If that player is in a group, use the average level of the group members nearby.
#        Default:     1 - enabled

DynamicScaling.World.GroupAverage = 1

#
#    DynamicScaling.World.Range
#        Description: Yards around a creature to look for players. 0 = the map's visibility distance
#                     (Visibility.Distance.Continents), so every creature you can see scales to you.
#        Default:     0

DynamicScaling.World.Range = 0

#
#    DynamicScaling.World.SilentLevelChange
#        Description: Change a creature's level without the client's level up effect: the creature is removed
#                     and created again for everyone who sees it. A creature someone has selected changes the
#                     normal way instead (with the effect when it goes up), so nobody loses their target.
#        Default:     1 - enabled
#                     0 - disabled (normal level change, with the level up effect when it goes up)

DynamicScaling.World.SilentLevelChange = 1

#
#    DynamicScaling.World.ScaleOnEngage
#        Description: When a creature engages, it takes the level of the player it engaged (their group's average
#                     nearby) for the whole fight; a player with scaling off fights its own level.
#        Default:     1 - enabled
#                     0 - disabled

DynamicScaling.World.ScaleOnEngage = 1

#
#    DynamicScaling.World.UpdateInterval
#        Description: Milliseconds between checks per creature. Creatures only change while out of combat.
#        Default:     2000

DynamicScaling.World.UpdateInterval = 2000

#
#    DynamicScaling.World.RescaleCooldown
#        Description: Milliseconds a creature keeps a level before it may change again.
#        Default:     10000

DynamicScaling.World.RescaleCooldown = 10000

#
#    DynamicScaling.World.UseDBOverride
#        Description: Take the categories that never scale from `dynamic_scaling_category` (one row per category,
#                     scale 0 never / 1 scales) instead of DynamicScaling.World.NeverScale below.
#        Default:     0 - use NeverScale
#                     1 - use the table

DynamicScaling.World.UseDBOverride = 0

#
#    DynamicScaling.World.NeverScale
#        Description: Kinds of creature that keep their own level in the open world, separated by spaces:
#                       NpcFlags     - vendors, quest givers, trainers, flight masters...
#                       Civilian     - civilians
#                       Guard        - guards
#                       PvP          - creatures friendly to Alliance or Horde players (PvP NPCs, faction
#                                      leaders, camp defenders, their gryphons, neutral friendly NPCs)
#                       Unattackable - creatures that can't be attacked or selected
#                       Elite, Rare, WorldBoss - by rank (a rare elite is both Elite and Rare)
#                       Boss         - dungeon bosses (CREATURE_FLAG_EXTRA_DUNGEON_BOSS)
#                     Pets and summons of a creature follow their owner. `dynamic_scaling_creature` (scale 0
#                     never / 1 always) beats this per creature entry. .dscale info shows which ones apply.
#        Default:     "NpcFlags Civilian Guard PvP Unattackable WorldBoss Boss"

DynamicScaling.World.NeverScale = "NpcFlags Civilian Guard PvP Unattackable WorldBoss Boss"

#
#    DynamicScaling.World.Off.NoQuestCreditLevels
#        Description: Players with scaling off: creatures this many levels or more below them give no quest
#                     progress and drop no quest items (open world, scaled places only), like Ascension.
#        Default:     5
#                     0 - disabled

DynamicScaling.World.Off.NoQuestCreditLevels = 5

#
#    DynamicScaling.World.XP.AlwaysAward
#        Description: Kills that give no XP (gray) still give a share of what a creature TrailLevels below
#                     you would give. Players who already got XP for the kill are not touched.
#        Default:     1 - enabled

DynamicScaling.World.XP.AlwaysAward = 1

#
#    DynamicScaling.World.XP.MinPct
#        Description: That share, in percent.
#        Default:     25

DynamicScaling.World.XP.MinPct = 25

#
#    DynamicScaling.World.XP.OnlyScaledZones
#        Description: Only in places where open world scaling is on.
#        Default:     1 - enabled

DynamicScaling.World.XP.OnlyScaledZones = 1

#
#    DynamicScaling.World.QuestXP.Enable
#        Description: Quests trail behind your level for XP: a quest never gives less than MinPct percent
#                     of what it would give if its level were TrailLevels below yours.
#        Default:     1 - enabled

DynamicScaling.World.QuestXP.Enable = 1
DynamicScaling.World.QuestXP.TrailLevels = 2
DynamicScaling.World.QuestXP.MinPct = 50

#
#    DynamicScaling.World.QuestXP.OnlyScaledZones
#        Description: Only for quests in places where open world scaling is on.
#        Default:     1 - enabled

DynamicScaling.World.QuestXP.OnlyScaledZones = 1

#
#    DynamicScaling.World.QuestMinLevel.Enable
#        Description: Lower quest level requirements where you are scaled (you stand by the quest giver):
#                     Simple - any level; Advanced - the zone's level_min at most; Off - unchanged.
#                     This needs the OnPlayerGetQuestMinLevel core hook, found when CMake runs. Without it, quests
#                     of scaled zones are lowered in memory for everyone instead, the way PlayerToggle.Default
#                     would (players with scaling off too); the database is never changed.
#        Default:     1 - enabled
#                     0 - disabled

DynamicScaling.World.QuestMinLevel.Enable = 1
